 #===============================================================================
 # find a executable
 #===============================================================================
+def cpu_count():
+    """Return the number of CPUs this process may use. Unlike
+    multiprocessing.cpu_count(), it honours the CPU affinity (e.g. docker
+    --cpuset-cpus) and the cgroup CPU quota of a container (e.g. docker --cpus,
+    Kubernetes CPU limits), where the former reports all the host's CPUs."""
+
+    import math
+    import multiprocessing
+    try:
+        count = len(os.sched_getaffinity(0))
+    except (AttributeError, OSError):
+        count = multiprocessing.cpu_count()
+    quota = None
+    try:
+        # cgroup v2: "<quota> <period>", or "max <period>" without a limit
+        with open('/sys/fs/cgroup/cpu.max') as fsock:
+            value, period = fsock.read().split()[:2]
+        if value != 'max':
+            quota = int(value) / int(period)
+    except (OSError, ValueError):
+        try:
+            # cgroup v1: a quota of -1 means no limit
+            with open('/sys/fs/cgroup/cpu/cpu.cfs_quota_us') as fsock:
+                value = int(fsock.read())
+            with open('/sys/fs/cgroup/cpu/cpu.cfs_period_us') as fsock:
+                period = int(fsock.read())
+            if value > 0:
+                quota = value / period
+        except (OSError, ValueError):
+            pass
+    if quota:
+        count = min(count, int(math.ceil(quota)))
+    return max(1, count)
+
