+#===============================================================================
+# Fast LHE event counting and splitting
+#===============================================================================
+LHE_EVENT_START = re.compile(rb'^<event[ >]', re.M)
+LHE_FOOTER = b'</LesHouchesEvents>'
+
+
+def read_lhe_chunks(path, size=1 << 24):
+    """Yield the decompressed bytes of an LHE file in chunks, decompressing a
+    .gz file with pigz when it is available."""
+
+    if not path.endswith('.gz'):
+        with open(path, 'rb') as fsock:
+            for chunk in iter(lambda: fsock.read(size), b''):
+                yield chunk
+        return
+    pigz = misc.which('pigz')
+    if not pigz:
+        import gzip
+        with gzip.open(path, 'rb') as fsock:
+            for chunk in iter(lambda: fsock.read(size), b''):
+                yield chunk
+        return
+    proc = subprocess.Popen([pigz, '-dc', path], stdout=subprocess.PIPE)
+    try:
+        for chunk in iter(lambda: proc.stdout.read(size), b''):
+            yield chunk
+    finally:
+        proc.stdout.close()
+        if proc.wait() != 0:
+            raise IOError('pigz could not decompress %s' % path)
+
+
+def iter_lhe_events(path):
+    """Yield ('header', text) once, then ('event', text) for the start of each
+    event and ('text', text) for the bytes that follow it, then ('footer', b'')
+    at the end of the file. The event text is copied byte for byte, without
+    parsing. Raise ValueError for a file this can't handle (no <init> block,
+    or event groups)."""
+
+    header = None
+    buf = b''
+    chunks = read_lhe_chunks(path)
+    while True:
+        chunk = next(chunks, b'')
+        if b'<eventgroup' in chunk:
+            raise ValueError('event groups are not supported')
+        buf += chunk
+        if header is None:
+            init_end = buf.find(b'</init>')
+            match = LHE_EVENT_START.search(buf, init_end) if init_end != -1 else None
+            if not match:
+                if not chunk:
+                    raise ValueError('no <init> block or no events')
+                continue
+            header = buf[:match.start()]
+            buf = buf[match.start():]
+            yield 'header', header
+        if chunk:
+            # an event tag or the footer may straddle two chunks: hold the
+            # last bytes back
+            limit = max(0, len(buf) - 64)
+        else:
+            footer = buf.rfind(LHE_FOOTER)
+            limit = footer if footer != -1 else len(buf)
+        pos = 0
+        for match in LHE_EVENT_START.finditer(buf):
+            if match.start() >= limit:
+                break
+            yield 'text', buf[pos:match.start()]
+            yield 'event', b''
+            pos = match.start()
+        yield 'text', buf[pos:limit]
+        buf = buf[limit:]
+        if not chunk:
+            yield 'footer', b''
+            return
+
+
+def count_lhe_events(path):
+    """Return the number of events in an LHE file without parsing them, or
+    None if the file can't be read this way."""
+
+    try:
+        return sum(1 for kind, _text in iter_lhe_events(path) if kind == 'event')
+    except (ValueError, IOError, OSError):
+        return None
 
+
+def split_lhe_events(path, partition, out_paths):
+    """Split an LHE file into consecutive uncompressed files of partition[i]
+    events each, copying the header and the event text byte for byte. This is
+    much faster than lhe_parser.EventFile.split, which parses every event.
+    Return the number of files written, or None if the file can't be split
+    this way (the caller then falls back to EventFile.split)."""
+
+    out = None
+    index = -1
+    in_file = 0
+    try:
+        for kind, text in iter_lhe_events(path):
+            if kind == 'header':
+                header = text
+            elif kind == 'event':
+                if out is None or in_file == partition[index]:
+                    if out is not None:
+                        out.write(LHE_FOOTER + b'\n')
+                        out.close()
+                        out = None
+                    index += 1
+                    if index == len(partition):
+                        return index
+                    out = open(out_paths[index], 'wb')
+                    out.write(header)
+                    in_file = 0
+                in_file += 1
+            elif kind == 'text' and out is not None:
+                out.write(text)
+        if out is not None:
+            out.write(LHE_FOOTER + b'\n')
+            out.close()
+            out = None
+        return index + 1
+    except (ValueError, IOError, OSError) as error:
+        logger.debug('Fast LHE split failed (%s)' % error)
+        return None
+    finally:
+        if out is not None:
+            out.close()
+
