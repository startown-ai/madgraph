+    def find_hadd(self):
+        """Return the ROOT hadd utility (shipped with ROOT, which Delphes
+        requires), or None."""
+
+        if os.environ.get('ROOTSYS'):
+            candidate = pjoin(os.environ['ROOTSYS'], 'bin', 'hadd')
+            if os.path.exists(candidate):
+                return candidate
+        return misc.which('hadd')
+
+    def prepare_delphes_stream(self, tag):
+        """Return what the streamed per-split Delphes jobs of do_pythia8 need,
+        or None when streaming is not possible; Delphes then runs on the split
+        HepMC files after the shower instead."""
+
+        delphes_dir = self.options['delphes_path']
+        delphes_exe = pjoin(delphes_dir, 'DelphesHepMC2')
+        # Only Delphes 3 can read HepMC input (Delphes 2 ships a 'data' folder).
+        if os.path.exists(pjoin(delphes_dir, 'data')) or not os.path.exists(delphes_exe):
+            return None
+        hadd_exe = self.find_hadd()
+        if not hadd_exe or not misc.which('mkfifo'):
+            return None
+        card = pjoin(self.me_dir, 'Cards', 'delphes_card.dat')
+        # Update the banner with the Delphes card, as the standard do_delphes does.
+        if os.path.exists(pjoin(self.me_dir, 'Source', 'banner_header.txt')):
+            self.banner.add(card)
+            self.banner.write(pjoin(self.me_dir, 'Events', self.run_name,
+                                    '%s_%s_banner.txt' % (self.run_name, tag)))
+        logger.info('Streaming the Pythia8 splits into Delphes (no HepMC files on disk)')
+        return {'exe': delphes_exe, 'hadd': hadd_exe, 'card': card,
+                'run_seed': self.get_run_seed()}
