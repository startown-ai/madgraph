--- a/main164.cc
+++ b/main164delphes.cc
@@ -24,11 +24,18 @@
 //     ./main164 -c main164ckkwl.cmnd
 // where main164ckkwl.cmnd supplies the commands.
 // This example requires HepMC2 or HepMC3 and optionally RIVET.
+//
+// main164delphes is main164 with Delphes in the same process: with
+// Main:Delphes = on it runs Delphes (card Delphes:card, ROOT output
+// Delphes:output) on each event in memory, instead of writing HepMC text for
+// DelphesHepMC3 to read back. The output is the same; see
+// DelphesPythia8Event.h.
 
 #include "Pythia8/Pythia.h"
 #include "Pythia8Plugins/InputParser.h"
 #if defined(HEPMC3)
 #include "Pythia8Plugins/HepMC3.h"
+#include "DelphesPythia8Event.h"
 #elif defined(HEPMC2)
 #include "Pythia8Plugins/HepMC2.h"
 #endif
@@ -83,6 +90,11 @@
   pythia.settings.addFlag("Main:HepMC", false);
   pythia.settings.addWord("HepMC:output", "events.hepmc");
 
+  // New settings for the Delphes interface.
+  pythia.settings.addFlag("Main:Delphes", false);
+  pythia.settings.addWord("Delphes:card", "delphes_card.dat");
+  pythia.settings.addWord("Delphes:output", "delphes_events.root");
+
   // Input parameters:
   pythia.readFile(cmndFile, 0);
 
@@ -90,6 +102,17 @@
 #if defined(HEPMC2) || defined(HEPMC3)
   const bool doHepMC = pythia.flag("Main:HepMC");
   Pythia8ToHepMC* toHepMCPtr = nullptr;
+  const bool doDelphes = pythia.flag("Main:Delphes");
+  DelphesPythia8Output* delphesPtr = nullptr;
+  if (doDelphes) {
+    try {
+      delphesPtr = new DelphesPythia8Output(pythia.word("Delphes:card"),
+        pythia.word("Delphes:output"));
+    } catch (std::runtime_error& e) {
+      cerr << " Error in " << argv[0] << ": Delphes: " << e.what() << endl;
+      return 1;
+    }
+  }
   if (doHepMC) {
     toHepMCPtr = new Pythia8ToHepMC(pythia.word("HepMC:output"));
     // Switch off warnings for parton-level events.
@@ -265,7 +288,7 @@
 
       // Optionally perform internal analysis.
       if (doAnalysis) {
-        Event jetInput;
+        Pythia8::Event jetInput;
         jetInput.init("jet input", &pythia.particleData);
         jetInput.clear();
         for (int i =0; i < pythia.event.size(); ++i) {
@@ -299,6 +322,8 @@
         // Fill HepMC event.
         toHepMCPtr->writeNextEvent(pythia);
       }
+      // Optionally run Delphes on the event.
+      if (doDelphes) delphesPtr->Process(pythia);
 #endif
 
     }
@@ -336,6 +361,10 @@
   // Optionally delete HepMC converter pointer.
 #if defined(HEPMC2) || defined(HEPMC3)
   if (doHepMC) delete toHepMCPtr;
+  if (doDelphes) {
+    delphesPtr->Finish();
+    delete delphesPtr;
+  }
 #endif
 
   // Optionally print histograms of internal analysis.
