+    def get_run_seed(self):
+        """Return the seed MadEvent used for the current run, as recorded in its
+        banner (also when iseed = 0 let MadGraph pick it), or None."""
+
+        if self.banner and 'mgruncard' in self.banner:
+            found = re.search(r'^\s*(-?\d+)\s*=\s*iseed', self.banner['mgruncard'], re.M)
+            if found and int(found.group(1)) != 0:
+                return abs(int(found.group(1)))
+        return None
+
+    @staticmethod
+    def derive_seed(run_seed, tool, index=0):
+        """Return the seed of one job of a tool (e.g. split 'index' of 'pythia8'),
+        derived from the run seed. Tools and splits get independent streams, and
+        runs with neighbouring seeds share none. The range 1-900000000 suits both
+        Pythia8 (Random:seed) and Delphes (RandomSeed)."""
+
+        text = '%s:%s:%s' % (run_seed, tool, index)
+        return int(hashlib.sha256(text.encode()).hexdigest(), 16) % 900000000 + 1
+
+    def write_seeded_delphes_card(self, path, seed):
+        """Write the Delphes card to path with 'set RandomSeed <seed>' on top.
+        A RandomSeed set in the card itself comes later and still wins."""
+
+        card = open(pjoin(self.me_dir, 'Cards', 'delphes_card.dat')).read()
+        with open(path, 'w') as fsock:
+            fsock.write('set RandomSeed %d\n' % seed)
+            fsock.write(card)
+        return path
+
