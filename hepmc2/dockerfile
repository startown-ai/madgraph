FROM dhi.io/debian-base:trixie-dev@sha256:9e479c64f8d27f8fa368ef62804c2ddb9b3e43a68c13a200b2f668b4771b049e AS build

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      cmake=3.31.6-2 \
      g++=4:14.2.0-1+deb13u0+dhi0 \
      make=4.4.1-2+deb13u0+dhi1 \
      ninja-build=1.12.1-1+b1 \
      patch=2.8-2+deb13u0+dhi3 && \
    rm -rf /var/lib/apt/lists/*

ADD https://hepmc.web.cern.ch/hepmc/releases/hepmc2.06.11.tgz /tmp/hepmc2.tgz
COPY named-weights.patch /tmp/named-weights.patch

RUN mkdir /src && \
    tar -xzf /tmp/hepmc2.tgz -C /src --strip-components=1 && \
    patch -d /src -p1 < /tmp/named-weights.patch && \
    cmake -S /src -B /build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/opt/hepmc2 \
      -Dmomentum:STRING=GEV \
      -Dlength:STRING=MM && \
    cmake --build /build && \
    cmake --install /build

FROM build AS test

RUN ctest --test-dir /build --output-on-failure

FROM dhi.io/debian-base:trixie-dev@sha256:9e479c64f8d27f8fa368ef62804c2ddb9b3e43a68c13a200b2f668b4771b049e

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      cmake=3.31.6-2 \
      g++=4:14.2.0-1+deb13u0+dhi0 \
      make=4.4.1-2+deb13u0+dhi1 && \
    rm -rf /var/lib/apt/lists/*

COPY --from=build /opt/hepmc2 /opt/hepmc2
RUN echo /opt/hepmc2/lib > /etc/ld.so.conf.d/hepmc2.conf && \
    ldconfig

WORKDIR /root
CMD ["bash"]
